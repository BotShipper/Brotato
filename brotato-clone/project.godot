; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Brotato Clone"
run/main_scene="uid://cb10h88yku4ja"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://icon.svg"

[autoload]

Global="*res://autoloads/global.gd"
SoundManager="*res://autoloads/sound_manager.tscn"
GameManager="*res://autoloads/game_manager.gd"
UnlockManager="*res://autoloads/unlock_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://assets/": "red",
"res://autoloads/": "green",
"res://effects/": "orange",
"res://export/": "pink",
"res://resources/": "teal",
"res://scenes/": "yellow",
"res://scrsht/": "teal",
"res://shaders/": "blue",
"res://styles/": "purple"
}

[gui]

theme/custom_font="uid://kfh6ooeul77g"

